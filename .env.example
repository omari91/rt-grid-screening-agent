# Optional LLM provider keys (if unset, agent runs deterministic progressive-fidelity orchestration)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model override (e.g., gemini-2.5-flash, claude-sonnet-4-5, gpt-4o)
GRID_AGENT_MODEL=

# Optional path to full Ausgrid 2012-2013 CSV directory for full 17,520-interval sweeps
AUSGRID_DATA_DIR=
